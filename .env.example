# =============================================================================
# RiseRepute Environment Variables (Example Template)
# =============================================================================
# Copy this file to .env or .env.local for local development & deployment overrides.
# DO NOT commit real API keys, secrets, or production credentials to Git.
# =============================================================================

# Site Configuration
VITE_SITE_URL=https://riserepute.com
VITE_SITE_NAME="RiseRepute"

# Contact & Support Details (Publicly visible across website)
VITE_WHATSAPP_NUMBER="+923406523353"
VITE_WHATSAPP_URL="https://wa.me/923406523353"
VITE_CONTACT_EMAIL="usamahameedahmadani@gmail.com"

# =============================================================================
# Lead Capture Email Delivery (Formspree Integration)
# =============================================================================
# 1. Create a free form at https://formspree.io/
# 2. Set the recipient email to: usamahameedahmadani@gmail.com
# 3. Copy your Form ID (e.g. "xpwzaqvy") and paste the full endpoint URL below:
VITE_FORMSPREE_ENDPOINT="https://formspree.io/f/your_form_id"

# Fallback generic form endpoint (if using a custom webhook or backend API)
VITE_FORM_ENDPOINT_URL=""

# =============================================================================
# Analytics & Tracking (Phase 2 - To be activated with user-provided GA4 ID)
# =============================================================================
# Leave blank or unconfigured until an official Google Analytics 4 property is ready.
# Example: G-ABC123XYZ
VITE_GA4_MEASUREMENT_ID=""

# =============================================================================
# Supabase Relational Database & Authentication (RiseRepute BMS)
# =============================================================================
# Obtain these from your Supabase project dashboard -> Settings -> API:
# 1. Project URL (e.g. https://xyzcompany.supabase.co)
# 2. Anon / Public Key (eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
#
# Schema migration script is located at: supabase/migrations/20261114_initial_schema.sql
# Run the migration in Supabase SQL Editor before connecting.
#
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

